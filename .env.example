# Copier en .env.local (développement) et renseigner sur l'hébergeur (production).

# --- Supabase (obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement : jetons Spotify, suppression de compte.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (obligatoire en production, hors Vercel) ---
# Adresse publique, pour les liens envoyés par e-mail (ex. https://celeste.app).
NEXT_PUBLIC_SITE_URL=

# --- Claude (plan d'accompagnement) ---
ANTHROPIC_API_KEY=

# --- Spotify (playlist) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Facultatif : adresse de retour OAuth, sinon <origine>/api/spotify/callback.
SPOTIFY_REDIRECT_URI=

# --- Sentry (suivi des erreurs ; éteint sans DSN) ---
NEXT_PUBLIC_SENTRY_DSN=
# Facultatif : nom de l'environnement affiché dans Sentry (ex. production, beta).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Facultatif : envoi des cartes de code source au build (lisibilité des erreurs).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- PostHog (mesure d'audience sans cookies ; éteinte sans clé) ---
NEXT_PUBLIC_POSTHOG_KEY=
# Facultatif : hébergement UE par défaut.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
